<Window x:Class="DBAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB Analyzer" Height="820" Width="1280"
        Background="{StaticResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LLM API URL:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="TxtApiUrl"
                         Style="{StaticResource DarkTextBox}"
                         Text="https://47ea-113-53-46-55.ngrok-free.app/"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Save URL"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSaveUrl_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="TxtStatus"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0" Text="Ready"/>
                <TextBlock Grid.Column="4" Text="DB Analyzer v2.0"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar" Foreground="{StaticResource TextSecondary}" FontSize="12" Text="Ready"/>
                <ProgressBar x:Name="LoadingProgress" Grid.Column="1"
                             Width="150" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{StaticResource AccentColor}"
                             Background="{StaticResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl"
                    Style="{StaticResource DarkTabControl}">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
                </Style>
            </TabControl.Resources>

            <!-- ═══════════════════════════════════════════════════════
                 TAB 1 — ANALYSIS (Home)
                 ═══════════════════════════════════════════════════════ -->
            <TabItem Header="   Analysis   " Style="{StaticResource DarkTabItem}">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.34*" MinHeight="130"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.2*"  MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.46*" MinHeight="130"/>
                    </Grid.RowDefinitions>

                    <!-- Fetch Data Header Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Aggregated Data Context" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtContextSummary"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       Text="No data loaded yet. Configure sources in the Data Sources tab."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFetchData"
                                    Content="⬇  Fetch Data from All Sources"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnFetchData_Click"
                                    Padding="18,10" FontSize="14"
                                    Margin="0,0,8,0"/>
                            <Button Content="Clear Context"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnClearContext_Click" Padding="12,10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Aggregated Data Card View -->
                    <Border Grid.Row="1"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <StackPanel>
                                <!-- Empty state -->
                                <TextBlock x:Name="TxtEmptyContext"
                                           Text="No data yet — click &quot;Fetch Data from All Sources&quot; to load"
                                           Foreground="#555570" FontSize="13" FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           Margin="0,24,0,0"
                                           Visibility="Visible"/>
                                <ItemsControl x:Name="ContextItemsPanel">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E1E32"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Margin="0,0,0,8" Padding="12,10">
                                                <StackPanel>
                                                    <!-- Card header -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Header}"
                                                                   Foreground="{StaticResource AccentColor}"
                                                                   FontWeight="Bold" FontSize="12"/>
                                                        <Border Grid.Column="1"
                                                                Background="#2D2D50"
                                                                CornerRadius="10" Padding="8,2">
                                                            <TextBlock x:Name="RowCountBadge"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       FontSize="10"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Rows -->
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#25253A"
                                                                        CornerRadius="3"
                                                                        Padding="10,6" Margin="0,0,0,3">
                                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,1,16,1">
                                                                                    <TextBlock Text="{Binding Key}"
                                                                                               Foreground="{StaticResource TextSecondary}"
                                                                                               FontSize="11" FontFamily="Consolas"
                                                                                               MinWidth="130"/>
                                                                                    <TextBlock Text=" : "
                                                                                               Foreground="#444460" FontSize="11"/>
                                                                                    <TextBlock Text="{Binding Value}"
                                                                                               Foreground="{StaticResource TextPrimary}"
                                                                                               FontSize="11" FontFamily="Consolas"
                                                                                               MaxWidth="300"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Divider -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,6"/>

                    <!-- Analysis Prompt -->
                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Analysis Prompt"/>
                        <TextBox x:Name="TxtPrompt"
                                 Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Text="Analyze the data above and provide insights."/>
                    </DockPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6">
                        <Button x:Name="BtnSendToLlm"
                                Content="▶  Send to LLM"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnSendToLlm_Click"
                                Padding="18,8" FontSize="14" Margin="0,0,8,0"/>
                        <Button Content="Clear Response"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnClearResponse_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExportPdf"
                                Content="⬆  Export PDF"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnExportPdf_Click"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- LLM Response -->
                    <DockPanel Grid.Row="5">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="LLM Response"/>
                        <TextBox x:Name="TxtLlmResponse"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Background="#161626" Foreground="#E8E8FF"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════
                 TAB 2 — DATA SOURCES CONFIG
                 ═══════════════════════════════════════════════════════ -->
            <TabItem Header="   Data Sources   " Style="{StaticResource DarkTabItem}">
                <Grid Margin="16,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="260"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Connection List -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                   Text="Connections"/>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="+ Add"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddConnection_Click" Margin="0,0,4,0"/>
                            <Button Content="Remove"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnRemoveConnection_Click" Margin="0,0,4,0"/>
                            <Button Content="Duplicate"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnDuplicateConnection_Click"/>
                        </StackPanel>

                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ListBox x:Name="LstConnections"
                                     Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     BorderThickness="0"
                                     SelectionChanged="LstConnections_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11" Margin="0,1,0,0">
                                                <Run Text="{Binding Server}"/>
                                                <Run Text=" › "/>
                                                <Run Text="{Binding Database}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Vertical splitter -->
                    <Border Grid.Column="1" Width="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="3,0"/>

                    <!-- RIGHT: Edit Form -->
                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditPanel" IsEnabled="False">

                            <!-- Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SectionHeader}"
                                           x:Name="TxtEditHeader"
                                           Text="Select a connection to edit"
                                           VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="1"
                                        Content="Test Connection"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnTestConnection_Click"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="2"
                                        Content="Save Changes"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnSaveConnection_Click"/>
                            </Grid>

                            <!-- Connection Name -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CONNECTION NAME"/>
                            <TextBox x:Name="TxtEditName"
                                     Style="{StaticResource DarkTextBox}"
                                     FontSize="13" Margin="0,0,0,12"/>

                            <!-- Server -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SERVER"/>
                            <TextBox x:Name="TxtEditServer"
                                     Style="{StaticResource DarkTextBox}"
                                     FontSize="13" Margin="0,0,0,4"
                                     ToolTip="e.g.  192.168.1.10  or  localhost\SQLEXPRESS"/>
                            <TextBlock Text="e.g. 192.168.1.10  or  localhost\SQLEXPRESS"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" Margin="0,0,0,12"/>

                            <!-- Database -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="DATABASE"/>
                            <TextBox x:Name="TxtEditDatabase"
                                     Style="{StaticResource DarkTextBox}"
                                     FontSize="13" Margin="0,0,0,12"/>

                            <!-- Auth Mode -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="AUTHENTICATION"/>
                            <CheckBox x:Name="ChkWindowsAuth"
                                      Style="{StaticResource DarkCheckBox}"
                                      Content="Use Windows Authentication"
                                      Checked="ChkWindowsAuth_Changed"
                                      Unchecked="ChkWindowsAuth_Changed"
                                      Margin="0,4,0,12"/>

                            <!-- Credentials (hidden when Windows Auth) -->
                            <StackPanel x:Name="CredentialsPanel">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="USERNAME"/>
                                <TextBox x:Name="TxtEditUsername"
                                         Style="{StaticResource DarkTextBox}"
                                         FontSize="13" Margin="0,0,0,12"/>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="PASSWORD"/>
                                <PasswordBox x:Name="PwdEditPassword"
                                             Style="{StaticResource DarkPasswordBox}"
                                             FontSize="13" Margin="0,0,0,16"/>
                            </StackPanel>

                            <!-- SQL Query -->
                            <Border Background="#1A1A2E"
                                    BorderBrush="{StaticResource AccentColor}"
                                    BorderThickness="0,0,0,0"
                                    CornerRadius="4" Padding="12,10"
                                    Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}"
                                               Text="SQL QUERY FOR THIS SOURCE"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtEditQuery"
                                             Style="{StaticResource DarkTextBox}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Height="140"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Background="#131320"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="This query runs automatically when you click &quot;Fetch Data from All Sources&quot; on the Analysis tab."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
