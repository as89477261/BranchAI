<Window x:Class="DBAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB Analyzer" Height="800" Width="1300"
        Background="{StaticResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="LLM API URL:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="13" Margin="0,0,8,0"/>

                <TextBox Grid.Column="1" x:Name="TxtApiUrl"
                         Style="{StaticResource DarkTextBox}"
                         Text="https://47ea-113-53-46-55.ngrok-free.app/"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Save URL"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSaveUrl_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" x:Name="TxtStatus"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="16,0,0,0"
                           Text="Ready"/>

                <TextBlock Grid.Column="4"
                           Text="DB Analyzer v1.0"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Text="Ready"/>
                <ProgressBar x:Name="LoadingProgress"
                             Grid.Column="1"
                             Width="150" Height="4"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{StaticResource AccentColor}"
                             Background="{StaticResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0.7*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL — TabControl -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <TabControl Style="{StaticResource DarkTabControl}"
                            Margin="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: Connections -->
                    <TabItem Header="  Connections  " Style="{StaticResource DarkTabItem}">
                        <DockPanel Margin="12,10,12,12">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource SectionHeader}"
                                       Text="Database Connections"/>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ Add" Style="{StaticResource PrimaryButton}"
                                        Click="BtnAddConnection_Click" Margin="0,0,4,0"/>
                                <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                        Click="BtnRemoveConnection_Click" Margin="0,0,4,0"/>
                                <Button Content="Test" Style="{StaticResource SecondaryButton}"
                                        Click="BtnTestConnection_Click"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource SectionLabel}"
                                       Text="SAVED CONNECTIONS"
                                       Margin="0,0,0,4"/>

                            <ListBox x:Name="LstConnections"
                                     DockPanel.Dock="Top"
                                     Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     MinHeight="80"
                                     SelectionChanged="LstConnections_SelectionChanged"/>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 2: Query -->
                    <TabItem Header="  SQL Query  " Style="{StaticResource DarkTabItem}">
                        <DockPanel Margin="12,10,12,12">

                            <!-- Selected Connection badge -->
                            <Border DockPanel.Dock="Top"
                                    Background="#2D2D45"
                                    BorderBrush="{StaticResource AccentColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}"
                                               Text="ACTIVE CONNECTION" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtSelectedConnection"
                                               Foreground="{StaticResource AccentColor}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="— None selected —"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- SQL Query input -->
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource SectionLabel}"
                                       Text="SQL QUERY"/>
                            <TextBox DockPanel.Dock="Top"
                                     x:Name="TxtQuery"
                                     Style="{StaticResource DarkTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Height="110"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Text="SELECT TOP 100 * FROM "
                                     Margin="0,0,0,6"/>

                            <Button DockPanel.Dock="Top"
                                    Content="▶  Run Query"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnRunQuery_Click"
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Left"/>

                            <!-- Query Results -->
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource SectionHeader}"
                                       Text="Query Results"/>

                            <TextBlock DockPanel.Dock="Top"
                                       x:Name="TxtQueryResultInfo"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       Margin="0,0,0,4"
                                       Text=""/>

                            <DataGrid x:Name="DgResults"
                                      Style="{StaticResource DarkDataGrid}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Extended"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      FontSize="12"
                                      Foreground="{StaticResource TextPrimary}"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.32*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.22*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.46*" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <!-- Aggregated Data Context -->
                    <DockPanel Grid.Row="0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource SectionHeader}"
                                       Text="Aggregated Data Context"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="+ Add to Context"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddToContext_Click"
                                    Margin="0,0,6,0"/>
                            <Button Grid.Column="2"
                                    Content="Clear Context"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnClearContext_Click"/>
                        </Grid>

                        <!-- Context items list — cleaner card view -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ContextItemsPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E32"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,0,0,6"
                                                Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}"
                                                           Foreground="{StaticResource AccentColor}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#25253A"
                                                                    CornerRadius="3"
                                                                    Padding="8,5"
                                                                    Margin="0,0,0,3">
                                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                                <TextBlock Text="{Binding Key}"
                                                                                           Foreground="{StaticResource TextSecondary}"
                                                                                           FontSize="11"
                                                                                           MinWidth="140"
                                                                                           FontFamily="Consolas"/>
                                                                                <TextBlock Text=" : "
                                                                                           Foreground="{StaticResource BorderBrush}"
                                                                                           FontSize="11"/>
                                                                                <TextBlock Text="{Binding Value}"
                                                                                           Foreground="{StaticResource TextPrimary}"
                                                                                           FontSize="11"
                                                                                           FontFamily="Consolas"
                                                                                           TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,4"/>

                    <!-- Analysis Prompt -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource SectionHeader}"
                                   Text="Analysis Prompt"/>
                        <TextBox x:Name="TxtPrompt"
                                 Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Text="Analyze the data above and provide insights."/>
                    </DockPanel>

                    <!-- Action Button Row -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6">
                        <Button x:Name="BtnSendToLlm"
                                Content="▶  Send to LLM"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnSendToLlm_Click"
                                Padding="16,8"
                                FontSize="14"
                                Margin="0,0,8,0"/>
                        <Button Content="Clear Response"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnClearResponse_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="BtnExportPdf"
                                Content="Export PDF"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnExportPdf_Click"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- LLM Response -->
                    <DockPanel Grid.Row="4">
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource SectionHeader}"
                                   Text="LLM Response"/>
                        <TextBox x:Name="TxtLlmResponse"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Background="#161626"
                                 Foreground="#E8E8FF"
                                 Text=""/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
