<Window x:Class="DBAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB Analyzer" Height="860" Width="1320"
        Background="{StaticResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LLM API URL:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="TxtApiUrl"
                         Style="{StaticResource DarkTextBox}"
                         Text="https://47ea-113-53-46-55.ngrok-free.app/"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Save URL"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSaveUrl_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="TxtStatus"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12"
                           Margin="16,0,0,0" Text="Ready"/>
                <TextBlock Grid.Column="4" Text="DB Analyzer v2.1"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar" Foreground="{StaticResource TextSecondary}" FontSize="12" Text="Ready"/>
                <ProgressBar x:Name="LoadingProgress" Grid.Column="1"
                             Width="150" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{StaticResource AccentColor}"
                             Background="{StaticResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl x:Name="MainTabControl" Style="{StaticResource DarkTabControl}">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
                </Style>
            </TabControl.Resources>

            <!-- ═══════════════════════════════════════════
                 TAB 1 — ANALYSIS
                 ═══════════════════════════════════════════ -->
            <TabItem Header="   Analysis   " Style="{StaticResource DarkTabItem}">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── ID Input Card ── -->
                    <Border Grid.Row="0"
                            Background="#1A1A30"
                            BorderBrush="{StaticResource AccentColor}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="เลข 13 หลัก (บุคคล / นิติบุคคล)"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="ใช้ {ID} ใน SQL เพื่อแทนค่านี้อัตโนมัติ"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         x:Name="TxtCustomerId"
                                         Style="{StaticResource DarkTextBox}"
                                         MaxLength="13"
                                         FontSize="20"
                                         FontFamily="Consolas"
                                         FontWeight="Bold"
                                         Foreground="#A0E0FF"
                                         Background="#0D0D22"
                                         TextAlignment="Center"
                                         VerticalAlignment="Center"
                                         TextChanged="TxtCustomerId_TextChanged"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock x:Name="TxtIdValidation" FontSize="12" Margin="0,0,0,3"/>
                                    <TextBlock Text="ตัวอย่าง:  WHERE CustId = '{ID}'"
                                               Foreground="#555575" FontSize="10" FontFamily="Consolas"/>
                                </StackPanel>

                                <!-- DBD buttons -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                            Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button x:Name="BtnFetchDbd"
                                            Content="🏢 DBD Open Data"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnFetchDbd_Click"
                                            Padding="10,7" FontSize="12" Margin="0,0,6,0"
                                            ToolTip="ดึงข้อมูลทะเบียนนิติบุคคลจาก opendata.dbd.go.th (ฟรี)"/>
                                    <Button x:Name="BtnScrapeDatawarehouse"
                                            Content="📊 DataWarehouse"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnScrapeDatawarehouse_Click"
                                            Padding="10,7" FontSize="12"
                                            ToolTip="Scrape ข้อมูลนิติบุคคล + งบการเงินจาก datawarehouse.dbd.go.th"/>
                                </StackPanel>
                            </Grid>

                            <!-- Scraper Log Panel -->
                            <Border x:Name="ScraperLogBorder"
                                    Visibility="Collapsed"
                                    Background="#0A0A1A"
                                    BorderBrush="#2A2A50"
                                    BorderThickness="1" CornerRadius="4"
                                    Margin="0,10,0,0" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="📋 DBD Scraper — Status Log"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="Copy Log"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="BtnCopyLog_Click"
                                                Padding="8,2" FontSize="10"
                                                Margin="0,0,4,0"/>
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="BtnCloseLog_Click"
                                                Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ScrollViewer x:Name="LogScrollViewer"
                                                  MaxHeight="180"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TxtScraperLog"
                                                 Style="{StaticResource DarkTextBox}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#AADDAA"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- SQL Preview Panel (collapsed by default) -->
                            <Border x:Name="SqlPreviewBorder"
                                    Visibility="Collapsed"
                                    Background="#0D0D1E"
                                    BorderBrush="#333355"
                                    BorderThickness="1" CornerRadius="4"
                                    Margin="0,10,0,0" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="🔍 Preview SQL หลังแทนค่า {ID}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <Button HorizontalAlignment="Right"
                                                Content="✕" Style="{StaticResource SecondaryButton}"
                                                Click="BtnClosePreview_Click"
                                                Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="160"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TxtSqlPreview"
                                                 Style="{StaticResource DarkTextBox}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#88DDAA"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── 2-Column Body ── -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- ══════════════ LEFT COLUMN ══════════════ -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="0.55*" MinHeight="120"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="0.3*"  MinHeight="80"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fetch / Context Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SectionHeader}"
                                               Text="Aggregated Data Context" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtContextSummary"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                                               Text="No data loaded yet. Configure sources in the Data Sources tab, then click Fetch."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPreviewSql"
                                            Content="🔍 Preview SQL"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnPreviewSql_Click"
                                            Padding="10,8" Margin="0,0,6,0"
                                            ToolTip="แสดง SQL จริงที่จะรัน (หลังแทนค่า {ID} แล้ว)"/>
                                    <Button x:Name="BtnFetchData"
                                            Content="⬇  Fetch Data"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnFetchData_Click"
                                            Padding="14,8" FontSize="13" Margin="0,0,6,0"/>
                                    <Button Content="Clear"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnClearContext_Click" Padding="10,8"/>
                                </StackPanel>
                            </Grid>

                            <!-- Context Card List -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Margin="0,0,0,0">
                                <ScrollViewer x:Name="ContextScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="8,6">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtEmptyContext"
                                                   Text="ยังไม่มีข้อมูล — กรอก ID และกด &quot;Fetch Data&quot;"
                                                   Foreground="#555570" FontSize="13" FontStyle="Italic"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,20,0,0" Visibility="Visible"/>
                                        <ItemsControl x:Name="ContextItemsPanel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            CornerRadius="5"
                                                            BorderThickness="1"
                                                            BorderBrush="{Binding CardBorderColor}">
                                                        <StackPanel>
                                                            <Button Style="{StaticResource CardHeaderButton}"
                                                                    Background="{Binding CardHeaderBackground}"
                                                                    Tag="{Binding}"
                                                                    Click="CardHeader_Click">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding StatusIcon}"
                                                                               FontSize="14"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,10,0"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Header}"
                                                                               Foreground="{StaticResource TextPrimary}"
                                                                               FontSize="12" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Grid.Column="2"
                                                                            Background="#1E1E38"
                                                                            CornerRadius="10"
                                                                            Padding="8,2"
                                                                            Margin="8,0"
                                                                            VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ProgressBar
                                                                                Width="60" Height="3"
                                                                                IsIndeterminate="True"
                                                                                Foreground="{StaticResource AccentColor}"
                                                                                Background="Transparent"
                                                                                Margin="0,0,6,0"
                                                                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                                                                            <TextBlock Text="{Binding StatusText}"
                                                                                       Foreground="{StaticResource TextSecondary}"
                                                                                       FontSize="11"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding ExpandIcon}"
                                                                               Foreground="{StaticResource TextSecondary}"
                                                                               FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               Margin="4,0,0,0"/>
                                                                </Grid>
                                                            </Button>
                                                            <Border Background="#141424"
                                                                    Padding="10,8"
                                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock
                                                                        Foreground="#FF7070"
                                                                        FontSize="12" FontFamily="Consolas"
                                                                        TextWrapping="Wrap"
                                                                        Margin="0,0,0,6"
                                                                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                                                                        <Run Text="⚠  "/><Run Text="{Binding ErrorMessage}"/>
                                                                    </TextBlock>
                                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#1D1D30"
                                                                                        BorderBrush="#2A2A42"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="3"
                                                                                        Padding="10,7"
                                                                                        Margin="0,0,0,4">
                                                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Grid Margin="0,1">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="160" MinWidth="80"/>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Grid.Column="0"
                                                                                                               Text="{Binding Key}"
                                                                                                               Foreground="{StaticResource TextSecondary}"
                                                                                                               FontSize="11"
                                                                                                               FontFamily="Consolas"/>
                                                                                                    <TextBlock Grid.Column="1"
                                                                                                               Text=" :  "
                                                                                                               Foreground="#333355"
                                                                                                               FontSize="11"/>
                                                                                                    <TextBlock Grid.Column="2"
                                                                                                               Text="{Binding Value}"
                                                                                                               Foreground="{StaticResource TextPrimary}"
                                                                                                               FontSize="11"
                                                                                                               FontFamily="Consolas"
                                                                                                               TextWrapping="Wrap"/>
                                                                                                </Grid>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Divider -->
                            <Border Grid.Row="2" Height="1"
                                    Background="{StaticResource BorderBrush}" Margin="0,8"/>

                            <!-- Analysis Prompt -->
                            <DockPanel Grid.Row="3">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                           Text="Analysis Prompt"/>
                                <TextBox x:Name="TxtPrompt"
                                         Style="{StaticResource DarkTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="13"
                                         Text="Analyze the data above and provide insights."/>
                            </DockPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="BtnSendToLlm"
                                        Content="▶  Send to LLM"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnSendToLlm_Click"
                                        Padding="18,8" FontSize="14" Margin="0,0,8,0"/>
                                <Button Content="Clear Response"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnClearResponse_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnExportPdf"
                                        Content="⬆  Export PDF"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnExportPdf_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- GridSplitter -->
                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{StaticResource BorderBrush}"
                                      Cursor="SizeWE"/>

                        <!-- ══════════════ RIGHT COLUMN ══════════════ -->
                        <DockPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="LLM Response"/>
                            <TextBox x:Name="TxtLlmResponse"
                                     Style="{StaticResource DarkTextBox}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontSize="13" Background="#161626" Foreground="#E8E8FF"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════
                 TAB 2 — DATA SOURCES
                 ═══════════════════════════════════════════ -->
            <TabItem Header="   Data Sources   " Style="{StaticResource DarkTabItem}">
                <Grid Margin="16,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="220"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: Connection list ── -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                   Text="Connections"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="+ Add" Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddConnection_Click" Margin="0,0,4,0"/>
                            <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                    Click="BtnRemoveConnection_Click" Margin="0,0,4,0"/>
                            <Button Content="Copy" Style="{StaticResource SecondaryButton}"
                                    Click="BtnDuplicateConnection_Click"/>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ListBox x:Name="LstConnections"
                                     Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     BorderThickness="0"
                                     SelectionChanged="LstConnections_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11" Margin="0,1,0,0">
                                                <Run Text="{Binding Server}"/>
                                                <Run Text=" › "/>
                                                <Run Text="{Binding Database}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Vertical divider -->
                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                    <!-- ── RIGHT: Edit form ── -->
                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,0,4,0">
                        <StackPanel x:Name="EditPanel" IsEnabled="False">

                            <!-- Form header + actions -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TxtEditHeader"
                                           Style="{StaticResource SectionHeader}"
                                           Text="Select a connection to edit"
                                           VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="1" Content="Test Connection"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnTestConnection_Click" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Save Changes"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnSaveConnection_Click"/>
                            </Grid>

                            <!-- Connection fields (2-column layout) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="CONNECTION NAME"/>
                                    <TextBox x:Name="TxtEditName" Style="{StaticResource DarkTextBox}"
                                             FontSize="13" Margin="0,0,0,10"/>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="SERVER"/>
                                    <TextBox x:Name="TxtEditServer" Style="{StaticResource DarkTextBox}"
                                             FontSize="13" Margin="0,0,0,4"
                                             ToolTip="e.g. 192.168.1.10  or  localhost\SQLEXPRESS"/>
                                    <TextBlock Text="e.g. 192.168.1.10 or localhost\SQLEXPRESS"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10" Margin="0,0,0,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="DATABASE"/>
                                    <TextBox x:Name="TxtEditDatabase" Style="{StaticResource DarkTextBox}"
                                             FontSize="13" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkWindowsAuth"
                                              Style="{StaticResource DarkCheckBox}"
                                              Content="Windows Authentication"
                                              Checked="ChkWindowsAuth_Changed"
                                              Unchecked="ChkWindowsAuth_Changed"
                                              Margin="0,6,0,10"/>
                                </StackPanel>
                            </Grid>

                            <!-- Credentials (collapsed when Windows Auth) -->
                            <StackPanel x:Name="CredentialsPanel">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="USERNAME"/>
                                        <TextBox x:Name="TxtEditUsername" Style="{StaticResource DarkTextBox}" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="PASSWORD"/>
                                        <PasswordBox x:Name="PwdEditPassword" Style="{StaticResource DarkPasswordBox}" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ══ Queries Section ══ -->
                            <Border Background="#111125"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Queries header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="SQL QUERIES FOR THIS CONNECTION"
                                                   Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="+ Add Query"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="BtnAddQuery_Click"
                                                    Padding="10,4" FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Remove"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="BtnRemoveQuery_Click"
                                                    Padding="8,4" FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="↑"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="BtnMoveQueryUp_Click"
                                                    Padding="8,4" FontSize="12" Margin="0,0,4,0"/>
                                            <Button Content="↓"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="BtnMoveQueryDown_Click"
                                                    Padding="8,4" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Query list -->
                                    <Border Grid.Row="1"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ListBox x:Name="LstQueries"
                                                 Style="{StaticResource DarkListBox}"
                                                 ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                                 BorderThickness="0"
                                                 SelectionChanged="LstQueries_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="▸  " Foreground="{StaticResource AccentColor}"
                                                                   VerticalAlignment="Center" FontSize="11"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <!-- Query editor label -->
                                    <TextBlock Grid.Row="2"
                                               x:Name="TxtQueryEditorLabel"
                                               Style="{StaticResource SectionLabel}"
                                               Text="SELECT A QUERY ABOVE TO EDIT"
                                               Margin="0,10,0,4"/>

                                    <!-- Query name -->
                                    <StackPanel Grid.Row="3" x:Name="QueryEditorPanel"
                                                Visibility="Collapsed" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="QUERY NAME"/>
                                        <TextBox x:Name="TxtEditQueryName"
                                                 Style="{StaticResource DarkTextBox}"
                                                 FontSize="13" Margin="0,0,0,6"
                                                 TextChanged="TxtEditQueryName_TextChanged"/>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="SQL  (ใช้ {ID} แทนเลข 13 หลัก)"/>
                                    </StackPanel>

                                    <!-- SQL editor -->
                                    <TextBox Grid.Row="4"
                                             x:Name="TxtEditQuerySql"
                                             Style="{StaticResource DarkTextBox}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="12"
                                             Background="#0D0D1E"
                                             IsEnabled="False"
                                             TextChanged="TxtEditQuerySql_TextChanged"/>

                                    <!-- Hint -->
                                    <TextBlock Grid.Row="5"
                                               Text="Queries run top-to-bottom when you click &quot;Fetch Data&quot; on the Analysis tab."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
