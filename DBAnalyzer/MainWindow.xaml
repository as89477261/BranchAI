<Window x:Class="DBAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB Analyzer" Height="800" Width="1300"
        Background="{StaticResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="LLM API URL:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="13" Margin="0,0,8,0"/>

                <TextBox Grid.Column="1" x:Name="TxtApiUrl"
                         Style="{StaticResource DarkTextBox}"
                         Text="https://47ea-113-53-46-55.ngrok-free.app/"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Save URL"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSaveUrl_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" x:Name="TxtStatus"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="16,0,0,0"
                           Text="Ready"/>

                <TextBlock Grid.Column="4"
                           Text="DB Analyzer v1.0"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Text="Ready"/>
                <ProgressBar x:Name="LoadingProgress"
                             Grid.Column="1"
                             Width="150" Height="4"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{StaticResource AccentColor}"
                             Background="{StaticResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0.7*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12">

                    <!-- DB Connections Section -->
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}"
                               Text="Database Connections"/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="+ Add" Style="{StaticResource PrimaryButton}"
                                Click="BtnAddConnection_Click" Margin="0,0,4,0"/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                Click="BtnRemoveConnection_Click" Margin="0,0,4,0"/>
                        <Button Content="Test" Style="{StaticResource SecondaryButton}"
                                Click="BtnTestConnection_Click"/>
                    </StackPanel>

                    <ListBox DockPanel.Dock="Top"
                             x:Name="LstConnections"
                             Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             Height="140"
                             Margin="0,0,0,12"
                             SelectionChanged="LstConnections_SelectionChanged"/>

                    <!-- SQL Query Section -->
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}"
                               Text="SQL Query"/>

                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionLabel}"
                               Text="Selected Connection:"/>

                    <TextBlock DockPanel.Dock="Top"
                               x:Name="TxtSelectedConnection"
                               Foreground="{StaticResource AccentColor}"
                               FontSize="12"
                               Text="None selected"
                               Margin="0,0,0,6"/>

                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionLabel}"
                               Text="SQL Query:"/>

                    <TextBox DockPanel.Dock="Top"
                             x:Name="TxtQuery"
                             Style="{StaticResource DarkTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="100"
                             FontFamily="Consolas"
                             FontSize="12"
                             Text="SELECT TOP 100 * FROM "
                             Margin="0,0,0,6"/>

                    <Button DockPanel.Dock="Top"
                            Content="Run Query"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnRunQuery_Click"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"/>

                    <!-- Query Results -->
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}"
                               Text="Query Results"/>

                    <TextBlock DockPanel.Dock="Top"
                               x:Name="TxtQueryResultInfo"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               Margin="0,0,0,4"
                               Text=""/>

                    <DataGrid x:Name="DgResults"
                              Style="{StaticResource DarkDataGrid}"
                              ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              FontSize="12"
                              Foreground="{StaticResource TextPrimary}"/>

                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.35*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.25*" MinHeight="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.4*" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <!-- Aggregated Data -->
                    <DockPanel Grid.Row="0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource SectionHeader}"
                                       Text="Aggregated Data Context"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="+ Add to Context"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddToContext_Click"
                                    Margin="0,0,6,0"/>
                            <Button Grid.Column="2"
                                    Content="Clear Context"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnClearContext_Click"/>
                        </Grid>
                        <TextBox DockPanel.Dock="Top"
                                 x:Name="TxtAggregatedData"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Background="#16162A"
                                 Foreground="#A0C4FF"
                                 Text=""/>
                    </DockPanel>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,6"/>

                    <!-- Prompt -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource SectionHeader}"
                                   Text="Analysis Prompt"/>
                        <TextBox DockPanel.Dock="Top"
                                 x:Name="TxtPrompt"
                                 Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Text="Analyze the data above and provide insights."/>
                    </DockPanel>

                    <!-- Send Button Row -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6">
                        <Button x:Name="BtnSendToLlm"
                                Content="Send to LLM"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnSendToLlm_Click"
                                Padding="16,8"
                                FontSize="14"
                                Margin="0,0,8,0"/>
                        <Button Content="Clear Response"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnClearResponse_Click"/>
                    </StackPanel>

                    <!-- LLM Response -->
                    <DockPanel Grid.Row="4">
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource SectionHeader}"
                                   Text="LLM Response"/>
                        <TextBox DockPanel.Dock="Top"
                                 x:Name="TxtLlmResponse"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Background="#161626"
                                 Foreground="#E8E8FF"
                                 Text=""/>
                    </DockPanel>

                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
