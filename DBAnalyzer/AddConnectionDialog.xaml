<Window x:Class="DBAnalyzer.AddConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Database Connection"
        Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="New Database Connection"
                   Style="{StaticResource SectionHeader}"
                   FontSize="16"
                   Margin="0,0,0,16"/>

        <!-- Form -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Connection Name -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="CONNECTION NAME" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"
                         ToolTip="A friendly name for this connection"/>
            </StackPanel>

            <!-- Server -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="SERVER" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="TxtServer" Style="{StaticResource DarkTextBox}"
                         ToolTip="e.g. localhost\SQLEXPRESS or 192.168.1.100,1433"/>
            </StackPanel>

            <!-- Database -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="DATABASE" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="TxtDatabase" Style="{StaticResource DarkTextBox}"
                         ToolTip="Database name"/>
            </StackPanel>

            <!-- Windows Auth Checkbox -->
            <CheckBox Grid.Row="6"
                      x:Name="ChkWindowsAuth"
                      Content="Use Windows Authentication"
                      Style="{StaticResource DarkCheckBox}"
                      Checked="ChkWindowsAuth_Changed"
                      Unchecked="ChkWindowsAuth_Changed"/>

            <!-- Username -->
            <StackPanel Grid.Row="8" x:Name="PnlCredentials">
                <TextBlock Text="USERNAME" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="TxtUsername" Style="{StaticResource DarkTextBox}"
                         ToolTip="SQL Server login username"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="10" x:Name="PnlPassword">
                <TextBlock Text="PASSWORD" Style="{StaticResource SectionLabel}"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource DarkPasswordBox}"
                             ToolTip="SQL Server login password"/>
            </StackPanel>

            <!-- Test Connection -->
            <StackPanel Grid.Row="12" Orientation="Horizontal">
                <Button Content="Test Connection"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnTest_Click"
                        Padding="12,6"/>
                <TextBlock x:Name="TxtTestResult"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="10,0,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text=""/>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"
                    Width="80"
                    Margin="0,0,8,0"/>
            <Button Content="OK"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnOk_Click"
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>
